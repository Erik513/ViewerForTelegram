<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ViewerForTelegram</RootNamespace>
    <AssemblyName>ViewerForTelegram</AssemblyName>
    <StartupObject>ViewerForTelegram.Program</StartupObject>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Shown on the exe's "Details" tab. Version is also what AppUpdater
         compares against the GitHub release tags (vX.Y.Z) at startup. -->
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Viewer for Telegram</Product>
    <AssemblyTitle>Viewer for Telegram</AssemblyTitle>
    <Company>Erik Wink</Company>
    <Authors>Erik Wink</Authors>
    <Copyright>© 2026 Erik Wink</Copyright>
    <Description>Lists and plays the audio messages posted in a Telegram group or channel you belong to.</Description>
    <RepositoryUrl>https://github.com/Erik513/ViewerForTelegram</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico is also embedded so every window can use the full multi-
         resolution icon (StyledForm otherwise falls back to a 32px
         ExtractAssociatedIcon). logo.png is the title-bar logo. -->
    <EmbeddedResource Include="app.ico" />
    <EmbeddedResource Include="logo.png" />
  </ItemGroup>

  <!-- A single assembly. The layers are folders + namespaces:
         Data\   (Models, Interfaces, concrete access: WTelegramClient, cache, audio)
         Logic\  (Services - the orchestration logic)
         UI\     (Program.cs, Forms, Controls)
       Dependency direction by convention only:  UI -> Logic -> Data -->

  <ItemGroup>
    <!-- Shared UI library as fixed DLLs from lib\. ErikwnkCore must be listed
         explicitly (DLL references do not pull in dependencies). -->
    <Reference Include="ErikwnkWFUI">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkWFUI.dll</HintPath>
    </Reference>
    <Reference Include="ErikwnkCore">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkCore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- NAudio has no FLAC decoder; this managed one reports duration and
         seeks properly where Media Foundation's FLAC source does not. -->
    <PackageReference Include="BunLabs.NAudio.Flac" Version="2.0.1" />
    <PackageReference Include="WTelegramClient" Version="4.4.8" />
  </ItemGroup>

  <!-- On a Release publish, remove the IntelliSense XMLs and the lib PDBs -
       developer-only files, just ballast in the shipped folder. -->
  <Target Name="TrimPublishExtras" AfterTargets="Publish">
    <ItemGroup>
      <_PublishJunk Include="$(PublishDir)*.xml" />
      <_PublishJunk Include="$(PublishDir)ErikwnkWFUI.pdb" />
      <_PublishJunk Include="$(PublishDir)ErikwnkCore.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishJunk)" />
  </Target>

</Project>
