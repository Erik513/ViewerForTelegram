<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ViewerForTelegram</RootNamespace>
    <AssemblyName>ViewerForTelegram</AssemblyName>
    <StartupObject>ViewerForTelegram.Program</StartupObject>
    <!-- WebView2 ships a WPF flavor that expects WindowsBase 5.0 -
         harmless in a pure WinForms project, just noisy. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- A single assembly. The layers are folders + namespaces:
         Data\   (Models, Interfaces, concrete access: WTelegramClient, cache)
         Logic\  (Services - the orchestration logic)
         UI\     (Program.cs, Forms, Web\ = the WebView2 UI)
       Dependency direction by convention only:  UI -> Logic -> Data -->

  <ItemGroup>
    <!-- The HTML UI is copied to bin\...\web\ and loaded via a
         VirtualHostNameToFolderMapping in the WebView2. -->
    <None Remove="UI\Web\**\*" />
    <None Include="UI\Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared UI library as fixed DLLs from lib\. ErikwnkCore must be listed
         explicitly (DLL references do not pull in dependencies). -->
    <Reference Include="ErikwnkWFUI">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkWFUI.dll</HintPath>
    </Reference>
    <Reference Include="ErikwnkCore">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkCore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="WTelegramClient" Version="4.4.8" />
  </ItemGroup>

  <!-- On a Release publish, remove the IntelliSense XMLs and the lib PDBs -
       developer-only files, just ballast in the shipped folder. -->
  <Target Name="TrimPublishExtras" AfterTargets="Publish">
    <ItemGroup>
      <_PublishJunk Include="$(PublishDir)*.xml" />
      <_PublishJunk Include="$(PublishDir)ErikwnkWFUI.pdb" />
      <_PublishJunk Include="$(PublishDir)ErikwnkCore.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishJunk)" />
  </Target>

</Project>
