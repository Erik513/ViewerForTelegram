<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ViewerForTelegram</RootNamespace>
    <AssemblyName>ViewerForTelegram</AssemblyName>
    <StartupObject>ViewerForTelegram.Program</StartupObject>
    <!-- WebView2 bringt eine WPF-Variante mit, die WindowsBase 5.0 erwartet -
         in einem reinen WinForms-Projekt harmlos, nur laut. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Eine einzige Assembly. Die Schichten sind Ordner + Namespaces:
         Data\   (Models, Interfaces, konkreter Zugriff: WTelegramClient, Cache)
         Logic\  (Services - die Ablauflogik)
         UI\     (Program.cs, Forms, Web\ = die WebView2-Oberflaeche)
       Abhaengigkeitsrichtung nur per Konvention:  UI -> Logic -> Data -->

  <ItemGroup>
    <!-- Die HTML-Oberflaeche wird nach bin\...\web\ kopiert und ueber ein
         VirtualHostNameToFolderMapping in der WebView2 geladen. -->
    <None Remove="UI\Web\**\*" />
    <None Include="UI\Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>web\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Geteilte UI-Bibliothek als feste DLLs aus lib\. ErikwnkCore muss mit
         eingetragen werden (DLL-Referenzen ziehen keine Abhaengigkeiten mit). -->
    <Reference Include="ErikwnkWFUI">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkWFUI.dll</HintPath>
    </Reference>
    <Reference Include="ErikwnkCore">
      <HintPath>..\lib\ErikwnkWFUI\ErikwnkCore.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="WTelegramClient" Version="4.4.8" />
  </ItemGroup>

  <!-- Im Release-Publish die IntelliSense-XMLs und die Lib-PDBs wegräumen -
       reine Entwickler-Dateien, im Auslieferungsordner nur Ballast. -->
  <Target Name="TrimPublishExtras" AfterTargets="Publish">
    <ItemGroup>
      <_PublishJunk Include="$(PublishDir)*.xml" />
      <_PublishJunk Include="$(PublishDir)ErikwnkWFUI.pdb" />
      <_PublishJunk Include="$(PublishDir)ErikwnkCore.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishJunk)" />
  </Target>

</Project>
